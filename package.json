{
  "name": "fabrica-agil",
  "version": "0.1.0-beta.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm db:validate && pnpm check && pnpm build",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:demo:strategic": "tsx scripts/db-demo-strategic.ts",
    "db:setup": "pnpm db:deploy && pnpm db:seed",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-local.ps1 start",
    "db:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-local.ps1 status",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-local.ps1 stop",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@openai/agents": "^0.14.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.2",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
